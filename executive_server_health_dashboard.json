        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 6
        },
        "id": 8,
        "options": {
          "legend": {
            "calcs": [
              "last",
              "max",
              "mean"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "pluginVersion": "10.4.0",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "avg(100 - avg by (instance, job) (irate(node_cpu_seconds_total{mode=\"idle\", job=~\"$job\"}[5m])) * 100)",
            "instant": false,
            "legendFormat": "Avg CPU %",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "avg(100 * (1 - avg by (instance, job) (node_memory_MemAvailable_bytes{job=~\"$job\"} / node_memory_MemTotal_bytes{job=~\"$job\"})))",
            "instant": false,
            "legendFormat": "Avg Memory %",
            "range": true,
            "refId": "B"
          }
        ],
        "title": "📈 Overall Resource Utilization Trends (Avg across devices)",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 14
        },
        "id": 9,
        "panels": [],
        "title": "🖥️ 2. Device Table View - Detailed Metrics & RAG Status (Sortable | Color-Coded | Click to Drilldown)",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "Detailed per-device view. Color coding provides instant RAG status (Green=Healthy, Yellow=Warning, Red=Critical). Sort by CPU% or Memory% descending to surface problems first. Click on any Instance name to open detailed drilldown dashboard (configure the Data Link below with your actual detail dashboard UID). Use Job filter to focus on Linux vs Windows or specific types. Data from Prometheus node_exporter (adapt queries for Windows metrics if needed).",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Instance"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 280
                },
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "🔍 Drilldown to Details for ${__data.fields.Instance}",
                      "url": "/d/YOUR-DETAIL-DASHBOARD-UID-HERE/node-exporter-full?var-job=${__data.fields.Job}&var-node=${__data.fields.Instance}&from=${__from}&to=${__to}"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "CPU %"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "decimals",
                  "value": 1
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 60
                      },
                      {
                        "color": "red",
                        "value": 80
                      }
                    ]
                  }
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "custom.width",
                  "value": 120
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Memory %"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "decimals",
                  "value": 1
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 75
                      },
                      {
                        "color": "red",
                        "value": 90
                      }
                    ]
                  }
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "custom.width",
                  "value": 120
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Net In (MB/s)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "MBps"
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.width",
                  "value": 140
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Net Out (MB/s)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "MBps"
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.width",
                  "value": 140
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Job"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 160
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 18,
          "w": 24,
          "x": 0,
          "y": 15
        },
        "id": 10,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": true
          },
          "showHeader": true,
          "sortBy": [
            {
              "desc": true,
              "displayName": "CPU %"
            }
          ]
        },
        "pluginVersion": "10.4.0",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "100 - avg by (instance, job) (irate(node_cpu_seconds_total{mode=\"idle\", job=~\"$job\"}[5m])) * 100",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "100 * (1 - avg by (instance, job) (node_memory_MemAvailable_bytes{job=~\"$job\"} / node_memory_MemTotal_bytes{job=~\"$job\"}))",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum by (instance, job) (rate(node_network_receive_bytes_total{job=~\"$job\", device!~\"lo|docker.*|veth.*|br.*|virbr.*|tun.*|tap.*\"}[5m])) / 1024 / 1024",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum by (instance, job) (rate(node_network_transmit_bytes_total{job=~\"$job\", device!~\"lo|docker.*|veth.*|br.*|virbr.*|tun.*|tap.*\"}[5m])) / 1024 / 1024",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "D"
          }
        ],
        "title": "Device Health Table (RAG Color-Coded Metrics | Sort to Prioritize Issues)",
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "instance 1": true,
                "instance 2": true,
                "instance 3": true,
                "job 1": true,
                "job 2": true,
                "job 3": true
              },
              "indexByName": {
                "Value #A": 2,
                "Value #B": 3,
                "Value #C": 4,
                "Value #D": 5,
                "instance": 0,
                "job": 1
              },
              "renameByName": {
                "Value #A": "CPU %",
                "Value #B": "Memory %",
                "Value #C": "Net In (MB/s)",
                "Value #D": "Net Out (MB/s)",
                "instance": "Instance",
                "job": "Job"
              }
