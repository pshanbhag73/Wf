/* Force horizontal layout */
.mat-mdc-menu-content,          /* Angular Material 15+ (MDC-based) */
.mat-menu-content {             /* Older versions */
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap;              /* optional – allows wrapping */
  padding: 4px 0 !important;
  gap: 4px;                     /* spacing between items */
}

/* Make each item shrink to content width */
.mat-mdc-menu-item,
.mat-menu-item {
  min-width: auto !important;
  width: auto !important;
  height: 40px !important;      /* optional – adjust height */
  line-height: 40px !important;
  padding: 0 12px !important;
}

/* Optional: remove default vertical padding from the panel */
.mat-mdc-menu-panel,
.mat-menu-panel {
  max-width: none !important;   /* allow the menu to grow wider */
}
