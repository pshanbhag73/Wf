                    <td class="green">14/19</td>
                    <td class="green">12/18</td>
                    <td class="green">8/12</td>
                    <td onclick="showOCPDetails('Retail Banking - auth-service', 'us-west-2', '22/24', 'Healthy')" class="green">22/24</td>
                    <td class="green">19/23</td>
                    <td class="green">15/20</td>
                    <td class="green">9/14</td>
                    <td class="muted-green">7/11</td>
                    <td class="muted-green">5/9</td>
                    <td class="muted-green">4/8</td>
                    <td class="muted-green">3/6</td>
                    <td class="muted-green">6/10</td>
                    <td class="muted-green">4/8</td>
                    <td class="muted-green">3/7</td>
                    <td class="muted-green">2/5</td>
                </tr>

                <tr class="hover:bg-slate-800/50">
                    <td class="app-name">Payments - prod-db-cluster</td>
                    <td onclick="showOCPDetails('Payments - prod-db-cluster', 'us-east-1', '21/24', 'Spike')" class="green">21/24</td>
                    <td class="green">17/22</td>
                    <td class="green">14/19</td>
                    <td class="green">11/15</td>
                    <td onclick="showOCPDetails('Payments - prod-db-cluster', 'us-west-2', '23/24', 'Healthy')" class="green">23/24</td>
                    <td class="green">20/23</td>
                    <td class="green">16/21</td>
                    <td class="green">12/17</td>
