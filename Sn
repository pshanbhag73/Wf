                </div>
                <div class="text-slate-400">Auto-refresh every 2 minutes</div>
            </div>
            <div class="text-slate-400 text-sm">5,000 Apps • 12 Datacenters (4 New-Gen)</div>
        </div>

        <!-- Filter Bar -->
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-3 mb-6 flex gap-4 text-sm">
            <div class="bg-slate-700 px-4 py-2 rounded-lg cursor-pointer">LOB: <span class="font-semibold">All</span> ▼</div>
            <div class="bg-slate-700 px-4 py-2 rounded-lg cursor-pointer">Region: <span class="font-semibold">All</span> ▼</div>
            <div class="bg-slate-700 px-4 py-2 rounded-lg cursor-pointer">DC Type: <span class="font-semibold">New-Gen + Heritage</span> ▼</div>
            <div class="bg-slate-700 px-4 py-2 rounded-lg cursor-pointer">Compute: <span class="font-semibold">All</span> ▼</div>
        </div>

