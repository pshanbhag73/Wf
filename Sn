<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What's Running Where - New-Gen vs Heritage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', system-ui, sans-serif; }
        table { border-collapse: collapse; }
        th, td { border: 1px solid #334155; padding: 4px 8px; font-size: 12px; text-align: center; }
        .app-name { text-align: left; padding-left: 12px; font-weight: 600; cursor: pointer; }
        .header-newgen { background: #166534; color: white; }
        .header-heritage { background: #334155; color: white; }
        .region-east { background: #1e40af; color: white; }
        .region-west { background: #1e40af; color: white; }
        .green { background: #166534; color: white; cursor: pointer; }
        .muted-green { background: #4ade80; color: #0f172a; font-weight: 600; cursor: pointer; }
        .yellow { background: #eab308; color: #0f172a; cursor: pointer; }
        .red { background: #ef4444; color: white; cursor: pointer; }
        .modal { animation: modalPop 0.3s ease-out; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 p-6">

