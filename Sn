<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What's Running Where</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', system-ui, sans-serif; }
        .expandable-row { cursor: pointer; }
        .expandable-row:hover { background-color: #1e2937; }
        .expand-content { display: none; }
        .expanded .expand-content { display: table-row; }
        .status-active { background-color: #166534; color: white; }
        .status-passive { background-color: #c2410c; color: white; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 p-6">

    <div class="max-w-[2100px] mx-auto">
        
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-4xl font-bold">What's Running Where</h1>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 bg-slate-800 px-4 py-1.5 rounded-full">
                    <div class="w-2.5 h-2.5 bg-emerald-400 rounded-full animate-pulse"></div>
                    <span class="text-emerald-400 text-sm font-medium">LIVE</span>
                </div>
                <div class="text-slate-400 text-sm">Auto-refresh every 2 min</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex border-b border-slate-700 mb-6">
            <button onclick="switchTab(0)" id="tab-0"
                    class="px-8 py-4 text-lg border-b-4 border-emerald-500 font-semibold">1. Datacenters (App Level)</button>
            <button onclick="switchTab(1)" id="tab-1"
                    class="px-8 py-4 text-lg text-slate-400 hover:text-white">2. Expanded Detailed View</button>
        </div>

        <!-- TAB 1: Datacenters View with Row-Level Expansion -->
        <div id="tab-content-0">
            <div class="bg-slate-900 border border-slate-700 rounded-2xl overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-700">
                    <div class="text-xl font-semibold">New-Gen Datacenters - App Volumes</div>
                    <div class="text-emerald-400 text-sm">Click any app to expand and see component-level status</div>
                </div>

                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-800 text-slate-300">
                            <th class="text-left px-6 py-4">App / Component</th>
                            <th class="px-4 py-4 text-center">us-east-1</th>
                            <th class="px-4 py-4 text-center">us-east-2</th>
                            <th class="px-4 py-4 text-center">us-west-2</th>
                            <th class="px-4 py-4 text-center">us-west-1</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        <!-- Expandable App Row 1 -->
                        <tr class="expandable-row border-b border-slate-700 hover:bg-slate-800/50" onclick="toggleExpand(this)">
                            <td class="px-6 py-4 font-semibold flex items-center gap-2">
                                <span>▶</span> Retail Banking - auth-service
                            </td>
                            <td class="px-4 py-4 text-center font-mono">892</td>
                            <td class="px-4 py-4 text-center font-mono">674</td>
                            <td class="px-4 py-4 text-center font-mono">1,034</td>
                            <td class="px-4 py-4 text-center font-mono">521</td>
                        </tr>
                        
                        <!-- Expanded Content Row 1 -->
                        <tr class="expand-content bg-slate-950 border-b border-slate-700">
                            <td colspan="5" class="px-6 py-4">
                                <div class="pl-8">
                                    <table class="w-full text-xs">
                                        <tr>
                                            <td class="py-1.5 text-slate-400 w-48">API Pods (OCP)</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-1.5 text-slate-400">Oracle RAC</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-1.5 text-slate-400">Redis Cluster</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                            <td class="px-4 py-1.5"></td>
                                        </tr>
                                        <tr>
                                            <td class="py-1.5 text-slate-400">Kafka Topics</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                        <!-- Expandable App Row 2 -->
                        <tr class="expandable-row border-b border-slate-700 hover:bg-slate-800/50" onclick="toggleExpand(this)">
                            <td class="px-6 py-4 font-semibold flex items-center gap-2">
                                <span>▶</span> Payments - prod-db-cluster
                            </td>
                            <td class="px-4 py-4 text-center font-mono">1,245</td>
                            <td class="px-4 py-4 text-center font-mono">983</td>
                            <td class="px-4 py-4 text-center font-mono">1,478</td>
                            <td class="px-4 py-4 text-center font-mono">892</td>
                        </tr>
                        
                        <tr class="expand-content bg-slate-950 border-b border-slate-700">
                            <td colspan="5" class="px-6 py-4">
                                <div class="pl-8">
                                    <table class="w-full text-xs">
                                        <tr>
                                            <td class="py-1.5 text-slate-400 w-48">API Pods (OCP)</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-1.5 text-slate-400">Oracle RAC</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-passive px-3 py-0.5 rounded text-xs">PASSIVE</span></td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                        <!-- More apps... (you can add more) -->
                        <tr class="expandable-row border-b border-slate-700 hover:bg-slate-800/50" onclick="toggleExpand(this)">
                            <td class="px-6 py-4 font-semibold flex items-center gap-2">
                                <span>▶</span> Customer Services - user-api
                            </td>
                            <td class="px-4 py-4 text-center font-mono">674</td>
                            <td class="px-4 py-4 text-center font-mono">521</td>
                            <td class="px-4 py-4 text-center font-mono">892</td>
                            <td class="px-4 py-4 text-center font-mono">456</td>
                        </tr>
                        
                        <tr class="expand-content bg-slate-950 border-b border-slate-700">
                            <td colspan="5" class="px-6 py-4">
                                <div class="pl-8">
                                    <table class="w-full text-xs">
                                        <tr>
                                            <td class="py-1.5 text-slate-400 w-48">API Pods (OCP)</td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                            <td class="px-4 py-1.5"><span class="status-active px-3 py-0.5 rounded text-xs">ACTIVE</span></td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: Expanded Detailed View (placeholder) -->
        <div id="tab-content-1" class="hidden">
            <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6">
                <h2 class="text-2xl font-semibold mb-6">Expanded Detailed View</h2>
                <p class="text-slate-400">Full detailed view coming soon...</p>
            </div>
        </div>
    </div>

    <script>
        function toggleExpand(row) {
            const nextRow = row.nextElementSibling;
            if (nextRow && nextRow.classList.contains('expand-content')) {
                const isExpanded = nextRow.style.display === 'table-row';
                nextRow.style.display = isExpanded ? 'none' : 'table-row';
                row.classList.toggle('expanded', !isExpanded);
                
                // Toggle arrow
                const arrow = row.querySelector('span');
                if (arrow) arrow.textContent = isExpanded ? '▶' : '▼';
            }
        }

        function switchTab(tab) {
            document.getElementById('tab-content-0').classList.add('hidden');
            document.getElementById('tab-content-1').classList.add('hidden');
            document.getElementById('tab-0').classList.remove('border-b-4', 'border-emerald-500');
            document.getElementById('tab-1').classList.remove('border-b-4', 'border-emerald-500');

            if (tab === 0) {
                document.getElementById('tab-content-0').classList.remove('hidden');
                document.getElementById('tab-0').classList.add('border-b-4', 'border-emerald-500');
            } else {
                document.getElementById('tab-content-1').classList.remove('hidden');
                document.getElementById('tab-1').classList.add('border-b-4', 'border-emerald-500');
            }
        }

        window.onload = function() {
            document.getElementById('tab-0').classList.add('border-b-4', 'border-emerald-500');
        }
    </script>
</body>
</html>
