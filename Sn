                    <!-- Heritage -->
                    <th colspan="8" class="header-heritage text-lg py-1">HERITAGE (8 DCs)</th>
                </tr>
                <tr>
                    <th colspan="4" class="region-east py-1">EAST<br><span class="text-xs">(us-east-1 • us-east-2)</span></th>
                    <th colspan="4" class="region-west py-1">WEST<br><span class="text-xs">(us-west-2 • us-west-1)</span></th>
                    <th colspan="4" class="region-east py-1">EAST<br><span class="text-xs">(Legacy)</span></th>
                    <th colspan="4" class="region-west py-1">WEST<br><span class="text-xs">(Legacy)</span></th>
                </tr>
                <tr class="bg-slate-800 text-slate-300 text-[10px]">
                    <th class="py-1">OCP</th><th class="py-1">VM</th><th class="py-1">DB</th><th class="py-1">Avi</th>
                    <th class="py-1">OCP</th><th class="py-1">VM</th><th class="py-1">DB</th><th class="py-1">Avi</th>
                    <th class="py-1">OCP</th><th class="py-1">VM</th><th class="py-1">DB</th><th class="py-1">Avi</th>
                    <th class="py-1">OCP</th><th class="py-1">VM</th><th class="py-1">DB</th><th class="py-1">Avi</th>
                </tr>
            </thead>

