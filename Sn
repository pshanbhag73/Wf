                </tr>

                <tr class="hover:bg-slate-800/50">
                    <td class="app-name">Customer Services - user-api</td>
                    <td onclick="showOCPDetails('Customer Services - user-api', 'us-east-2', '15/19', 'Healthy')" class="green">15/19</td>
                    <td class="green">12/16</td>
                    <td class="green">9/13</td>
                    <td class="green">6/10</td>
                    <td onclick="showOCPDetails('Customer Services - user-api', 'us-west-1', '18/22', 'Idle')" class="green">18/22</td>
