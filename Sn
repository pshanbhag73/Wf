            </tbody>
        </table>
    </div>

    <!-- Drill-down Modal -->
    <div id="modal" onclick="if(event.target === this) hideModal()" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
        <div onclick="event.stopImmediatePropagation()" class="modal bg-slate-800 rounded-2xl w-[620px] p-8 text-slate-100 shadow-2xl">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <div id="modal-app" class="text-2xl font-semibold"></div>
                    <div id="modal-dc" class="text-emerald-400 text-sm font-medium"></div>
                </div>
                <button onclick="hideModal()" class="text-slate-400 hover:text-white text-3xl leading-none">×</button>
            </div>

            <div class="grid grid-cols-3 gap-6 mb-8">
                <div class="bg-slate-900 rounded-xl p-5">
                    <div class="text-slate-400 text-xs">Current Load</div>
                    <div id="modal-current" class="text-4xl font-bold text-white"></div>
                </div>
                <div class="bg-slate-900 rounded-xl p-5">
                    <div class="text-slate-400 text-xs">Blended Baseline</div>
                    <div id="modal-baseline" class="text-4xl font-bold text-white"></div>
                </div>
                <div class="bg-slate-900 rounded-xl p-5">
                    <div class="text-slate-400 text-xs">Relative Delta</div>
                    <div id="modal-delta" class="text-4xl font-bold"></div>
                </div>
            </div>

            <div id="modal-reason" class="text-lg leading-relaxed mb-8"></div>

            <div class="text-xs text-slate-400">Last 12 minutes trend • OCP pods in this cell</div>

            <div class="mt-4 bg-slate-900 rounded-xl p-5 text-sm">
                <div id="modal-details" class="space-y-2"></div>
            </div>

            <div class="mt-8 text-center text-xs text-slate-400">
                Click anywhere outside to close • Data from MongoDB pipeline
            </div>
        </div>
    </div>

    <script>
        function showOCPDetails(app, dc, count, status) {
            const modal = document.getElementById('modal');
            document.getElementById('modal-app').textContent = app;
            document.getElementById('modal-dc').textContent = dc + " • OCP";

            // Realistic examples
            let current = count.split('/')[0];
            let baseline = Math.floor(Math.random() * 12) + 8;
            let delta = Math.round(((current - baseline) / baseline) * 100);

            document.getElementById('modal-current').textContent = current + "%";
            document.getElementById('modal-baseline').textContent = baseline + "%";
            document.getElementById('modal-delta').innerHTML = delta > 0 ? 
                `<span class="text-emerald-400">+${delta}%</span>` : 
                `<span class="text-amber-400">${delta}%</span>`;

            let reasonText = "";
            if (status === "Healthy") reasonText = "Load is steady and within expected range for this New-Gen DC.";
            else if (status === "Spike") reasonText = "Significant spike detected above blended baseline. Possible traffic surge.";
            else if (status === "Anomaly") reasonText = "Unexpected high activity or anomaly detected. Investigation recommended.";
            else reasonText = "Normal operation in this OCP cluster.";

            document.getElementById('modal-reason').innerHTML = `<span class="text-emerald-400 font-medium">Status:</span> ${reasonText}`;

            // Example pod list
            document.getElementById('modal-details').innerHTML = `
                <div class="flex justify-between text-xs"><span class="text-slate-400">pod-auth-01</span><span class="text-emerald-400">19%</span></div>
                <div class="flex justify-between text-xs"><span class="text-slate-400">pod-auth-02</span><span class="text-emerald-400">21%</span></div>
                <div class="flex justify-between text-xs"><span class="text-slate-400">pod-auth-03</span><span class="text-emerald-400">17%</span></div>
                <div class="flex justify-between text-xs"><span class="text-slate-400">pod-auth-04</span><span class="text-amber-400">24%</span></div>
            `;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function hideModal() {
            const modal = document.getElementById('modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Tailwind script already included
    </script>
</body>
</html>
