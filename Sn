                    <td class="green">18/22</td>
                    <td class="green">14/19</td>
                    <td class="green">9/13</td>
                    <td class="muted-green">10/15</td>
                    <td class="muted-green">8/12</td>
                    <td class="muted-green">6/10</td>
                    <td class="muted-green">4/7</td>
                    <td class="muted-green">7/11</td>
                    <td class="muted-green">5/9</td>
                    <td class="muted-green">4/8</td>
